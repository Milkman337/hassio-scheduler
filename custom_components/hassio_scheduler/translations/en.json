{
  "config": {
    "step": {
      "user": {
        "title": "Set up Scheduler",
        "description": "Scheduler adds a full-featured calendar-style scheduler to your sidebar. Schedules and their actions are managed entirely from that panel after setup - no configuration is needed here."
      }
    },
    "abort": {
      "already_configured": "Scheduler is already set up."
    }
  },
  "services": {
    "run_now": {
      "name": "Run now",
      "description": "Immediately run a schedule's actions, ignoring its configured time.",
      "fields": {
        "schedule_id": {
          "name": "Schedule",
          "description": "The schedule to run."
        },
        "timeslot_id": {
          "name": "Timeslot",
          "description": "Optional - only run a specific timeslot within the schedule."
        }
      }
    },
    "enable": {
      "name": "Enable",
      "description": "Enable a schedule.",
      "fields": {
        "schedule_id": {
          "name": "Schedule",
          "description": "The schedule to enable."
        }
      }
    },
    "disable": {
      "name": "Disable",
      "description": "Disable a schedule.",
      "fields": {
        "schedule_id": {
          "name": "Schedule",
          "description": "The schedule to disable."
        }
      }
    },
    "remove_schedule": {
      "name": "Remove schedule",
      "description": "Permanently delete a schedule.",
      "fields": {
        "schedule_id": {
          "name": "Schedule",
          "description": "The schedule to remove."
        }
      }
    }
  }
}
